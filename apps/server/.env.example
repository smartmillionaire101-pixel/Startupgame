# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/runway.db
# 32+ random characters. Required in production. Used to HMAC phone numbers and sign nothing else.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
WORLD_SEED=20261003
# Real minutes in one game month (every market settles once per month).
MONTH_MINUTES=5
# Dev conveniences: sign-in links (and legacy OTP codes) returned in the response, /api/dev/* routes enabled.
DEV_TOOLS=1
# Live FX feed (free, no key). Leave empty to use the seed snapshot only.
FX_FEED_URL=https://open.er-api.com/v6/latest/USD
# Token for the internal economy dashboard (GET /api/admin/economy).
ADMIN_TOKEN=
# Directory of the built web client to serve in production.
WEB_DIST=../web/dist
# Markets to open, in order (design doc §20). New ones open on the next boot.
OPEN_MARKETS=lagos,nairobi,london,accra,freetown,kigali,johannesburg,cairo,dubai
# Email sign-in links. Production needs PUBLIC_URL and one provider (see README "Email sign-in").
PUBLIC_URL=
# Option 1: Resend.
RESEND_API_KEY=
# Option 2: SMTP, e.g. Gmail with an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
